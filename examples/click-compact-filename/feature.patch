+                )
+
+    def test_validation_before_filename_access(self):
+        # A10: all invalid options fail before invoking the filename protocol.
+        for limit in (True, False, 1.0, "5", [], {}, object(), 0, -1):
+            for shorten in (False, True):
+                with self.subTest(limit=limit, shorten=shorten):
+                    filename = FilenamePath("longfilename.txt")
+                    error = ValueError if type(limit) is int else TypeError
+                    message = (
+                        "max_length must be at least 1" if error is ValueError
+                        else "max_length must be an integer or None"
+                    )
+                    with self.assertRaises(error) as caught:
+                        click.format_filename(filename, shorten, max_length=limit)
+                    self.assertEqual(str(caught.exception), message)
+                    self.assertEqual(filename.calls, 0)
+
+    def test_signature_and_integer_limits(self):
+        # A12, A18: existing positional usage; keyword-only new option.
+        class Integer(int):
+            pass
