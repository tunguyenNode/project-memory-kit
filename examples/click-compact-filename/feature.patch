+        )
+        self.assertEqual(click.format_filename("abc", max_length=10**10000), "abc")
+        self.assertEqual(click.format_filename("abc", False), "abc")
+
+    def test_baseline_and_converted_inputs(self):
+        # A1, A11, A17: supported inputs, conversion order, and existing errors.
+        inputs = [
+            "", "abc.txt", "a\udcff.txt", b"bad\xff.txt", b"",
+            Path("longfilename.txt"), FilenamePath("longfilename.txt"),
+            FilenamePath(b"bad\xff.txt"), os.sep + "tmp" + os.sep,
+            None, 123, object(), FilenamePath(123), "\ud800",
+        ]
+        for filename in inputs:
+            for shorten in (False, True):
+                with self.subTest(filename=filename, shorten=shorten):
+                    try:
+                        expected = baseline_format(filename, shorten)
