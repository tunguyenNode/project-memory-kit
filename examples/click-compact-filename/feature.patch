+
+
+# unittest keeps the opt-in feature checks runnable without extra dependencies;
+# pytest also collects these TestCase methods as part of the normal suite.
+
+
+def baseline_format(filename, shorten=False):
+    """Pinned pre-feature conversion, retained as a compatibility oracle."""
+    filename = os.path.basename(filename) if shorten else os.fspath(filename)
+    if isinstance(filename, bytes):
+        return filename.decode(sys.getfilesystemencoding(), "replace")
+    return filename.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
+
+
+class FilenamePath:
+    def __init__(self, value):
+        self.value = value
+        self.calls = 0
+
+    def __fspath__(self):
+        self.calls += 1
+        return self.value
+
+
+class TestCompactFilename(unittest.TestCase):
+    def test_exact_vectors(self):
+        # A2–A7, A9, A15–A17: expectations are frozen product decisions.
+        cases = [
+            ("short.txt", 12, "short.txt"),
+            ("longfilename.txt", 12, "longfil….txt"),
+            ("archive.tar.gz", 10, "archiv….gz"),
+            (".bashrc", 5, ".bas…"),
+            ("abcdef.", 4, "ab…."),
+            ("abc.txt", 5, "abc.…"),
+            ("abc.txt", 6, "a….txt"),
+            ("abc.txt", 1, "…"),
+            ("", 1, ""),
+            ("abc", 3, "abc"),
+            ("😀😀😀.txt", 6, "😀….txt"),
+            ("e\u0301xyz", 2, "e…"),
+            ("..bashrc", 5, "..ba…"),
+            ("archive.tar.gz", 14, "archive.tar.gz"),
+            ("abc.txt", 7, "abc.txt"),
+            ("👩\u200d💻abc", 3, "👩\u200d…"),
+            (b"longfilename.txt", 12, "longfil….txt"),
+        ]
+        for filename, limit, expected in cases:
+            with self.subTest(filename=filename, limit=limit):
+                self.assertEqual(
+                    click.format_filename(filename, max_length=limit), expected
+                )
+
+    def test_native_paths(self):
+        # A8, A13, A14. Use actual host separators, including Windows hosts.
+        cases = [
+            (
+                os.sep + os.path.join("tmp", "longfilename.txt"),
+                True, 12, "longfil….txt",
+            ),
+            (os.sep + os.path.join("tmp", "longfilename.txt"), False, 12,
+             os.sep + "tmp" + os.sep + "lo….txt"),
+            (os.sep + os.path.join("dir.with.dot", "abcdef"), False, 8,
+             os.sep + "dir.wi…"),
+            (os.sep + os.path.join("tmp", "abcdef") + os.sep, True, 3, ""),
+            (os.sep + os.path.join("tmp", "abcdef") + os.sep, False, 5,
+             os.sep + "tmp…"),
+        ]
+        for filename, shorten, limit, expected in cases:
+            with self.subTest(filename=filename, shorten=shorten):
+                self.assertEqual(
