+    def test_deterministic_invariants(self):
+        # R3–R6 on varied extensions, Unicode, native and foreign separators.
+        prefixes = ["", "a", "abcdef", ".", "..", "漢字😀", "e\u0301", "👩\u200d💻",
+                    "\x1b[31m", "a\nb", "dir.with.dot" + os.sep,
+                    "C:\\tmp\\", "//server/share/"]
+        suffixes = ["", ".", ".txt", ".tar.gz", ".averylongextension"]
+        for prefix in prefixes:
